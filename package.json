{
  "name": "@aimbitgmbh/trillium-mcp",
  "version": "0.2.0",
  "description": "Model-neutral MCP server for TriliumNext Notes via ETAPI",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "trillium-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "docs",
    ".env.example",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "npm run clean && node node_modules/typescript/bin/tsc && node -e \"require('node:fs').chmodSync('dist/index.js', 0o755)\"",
    "clean": "rm -rf dist",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.tests.json --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "test:live": "tsx scripts/live-test.ts",
    "test:model": "tsx scripts/model-eval.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "prepare": "npm run build",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "llm",
    "ai-assistant",
    "ai-integration",
    "trilium",
    "triliumnext",
    "notes",
    "knowledge-base",
    "knowledge-management",
    "etapi",
    "note-taking",
    "personal-knowledge"
  ],
  "author": "aimbit GmbH <info@aimbit.de> (https://aimbit.de)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aimbitgmbh/trillium-mcp.git"
  },
  "homepage": "https://github.com/aimbitgmbh/trillium-mcp#readme",
  "bugs": {
    "url": "https://github.com/aimbitgmbh/trillium-mcp/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.4.2",
    "marked": "^18.0.11",
    "turndown": "^7.2.4",
    "undici": "^8.10.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^25.9.6",
    "@types/turndown": "^5.0.6",
    "ajv": "^8.20.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.0"
  },
  "overrides": {
    "fast-uri": "3.1.5"
  }
}
