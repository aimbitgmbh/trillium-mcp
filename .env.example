# Required: full Trilium ETAPI base URL and an ETAPI token
TRILLIUM_API_URL=http://localhost:8080/etapi
TRILLIUM_API_TOKEN=your-etapi-token

# Exactly READ or READ;WRITE. Start with READ.
TRILLIUM_PERMISSIONS=READ

# Secure default is true. Disable only for a trusted self-signed endpoint.
TRILLIUM_VERIFY_SSL=true

# Optional reliability and attachment limits
# TRILLIUM_REQUEST_TIMEOUT_MS=30000
# TRILLIUM_MAX_ATTACHMENT_BYTES=26214400
# TRILLIUM_EXPORTS_DIR=/absolute/path/to/trillium-exports
